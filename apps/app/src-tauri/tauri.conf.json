{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiaoMory",
  "version": "0.1.0",
  "identifier": "com.miaomory.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MiaoMory",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ChenXu233/MiaoMoryQwQ/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5NjdCNTI0MTI5QjY0QUUKUldTdVpKc1NKTFZuT1hzOXVRUldOWVl0SkEzQzY2YmcrR3g4Q1hVbnRrUXh0eTVaQi92TGV3Y3oK"
    }
  }
}
